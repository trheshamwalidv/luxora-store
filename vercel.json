{
  
  "$schema": "https://openapi.vercel.sh/vercel.json",
  
  "buildCommand": "pnpm run build:vercel",
  
  "outputDirectory": "dist/public",
  
  "functions": {
    
    "api/trpc.ts": {
      
      "includeFiles": "api/trpc/_handler.mjs"
      
    },
    
    "api/trpc/[...trpc].ts": {
      
      "includeFiles": "api/trpc/_handler.mjs"
      
    }
    
  },
  
  "rewrites": [
    
    {
      
      "source": "/:path((?!api/).*)",
      
      "destination": "/index.html"
      
    }
    
  ]
  
}



















